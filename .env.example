# Copy this file to .env and edit it. Never commit .env.

# Answer mode:
#   offline   -> keyword retrieval only, no API key needed (default)
#   anthropic -> Claude writes answers from the retrieved passages
LLM_PROVIDER=offline

# Needed only when LLM_PROVIDER=anthropic. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=your-api-key-here

# Optional settings
CHATBOT_MODEL=claude-opus-5-5
KNOWLEDGE_DIR=knowledge
HOST=127.0.0.1
PORT=5000
